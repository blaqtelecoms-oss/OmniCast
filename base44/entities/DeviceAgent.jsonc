{
  "name": "DeviceAgent",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Nine digit device ID people share to be connected to"
    },
    "label": {
      "type": "string",
      "description": "Friendly name of this computer"
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow"
      ]
    },
    "os_detail": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Companion version reported on registration"
    },
    "status": {
      "type": "string",
      "enum": [
        "pairing",
        "online",
        "offline",
        "revoked"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray",
        "red"
      ],
      "default": "pairing"
    },
    "unattended_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allow connections with the access password, without anyone at the keyboard"
    },
    "allow_pointer": {
      "type": "boolean",
      "default": true
    },
    "allow_keyboard": {
      "type": "boolean",
      "default": true
    },
    "allow_clipboard": {
      "type": "boolean",
      "default": false
    },
    "last_seen": {
      "type": "string",
      "description": "ISO timestamp of the companion's last heartbeat"
    },
    "pair_secret": {
      "type": "string",
      "description": "Single use secret baked into the installer; cleared once the companion registers"
    },
    "secret_hash": {
      "type": "string",
      "description": "Hash of the device secret the companion keeps locally"
    },
    "access_hash": {
      "type": "string",
      "description": "Salted hash of the unattended access password"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0
    },
    "locked_until": {
      "type": "string"
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ready",
        "input-only",
        "needs-permission",
        "unsupported",
        "unknown"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray",
        "gray"
      ],
      "default": "unknown",
      "description": "What this computer reported it can actually do right now"
    },
    "readiness_note": {
      "type": "string",
      "description": "What blocks a fully ready state, in the person's own words"
    },
    "capture_ready": {
      "type": "boolean",
      "default": false,
      "description": "Companion can capture the screen natively, without a browser tab"
    },
    "input_ready": {
      "type": "boolean",
      "default": false,
      "description": "Companion can apply mouse and keyboard input"
    },
    "ready_at": {
      "type": "string",
      "description": "ISO timestamp of the last readiness report"
    }
  },
  "required": [
    "device_id",
    "platform"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}