{
  "name": "ControlInput",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "move",
        "click",
        "key",
        "scroll"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "gray"
      ]
    },
    "from_role": {
      "type": "string",
      "enum": [
        "host",
        "guest"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ]
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "payload": {
      "type": "string"
    },
    "delivered": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "session_id",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}