{
  "name": "HelperDevice",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "Secret pairing token the native helper uses to reach this session"
    },
    "label": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "host",
        "guest"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ],
      "default": "guest"
    },
    "control_holder": {
      "type": "string",
      "enum": [
        "host",
        "guest"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ],
      "default": "host"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "connected",
        "revoked"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "waiting"
    },
    "last_seen": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}