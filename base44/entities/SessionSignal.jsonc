{
  "name": "SessionSignal",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "viewer-hello",
        "sdp-offer",
        "sdp-answer",
        "host-stop",
        "join-request",
        "join-accept",
        "join-decline",
        "control-set"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray",
        "yellow",
        "green",
        "red",
        "pink"
      ]
    },
    "from_role": {
      "type": "string",
      "enum": [
        "host",
        "viewer"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ]
    },
    "viewer_key": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "kind",
    "from_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}