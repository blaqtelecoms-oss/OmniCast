{
  "name": "RoomEvent",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "pointer",
        "click",
        "note"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple"
      ]
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "sender_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}